#!/usr/bin/sh
# preinst script for millipede-caster.
#
# See: dh_installdeb(1).

set -e

# Summary of how this script can be called:
#        * <new-preinst> 'install'
#        * <new-preinst> 'install' <old-version>
#        * <new-preinst> 'upgrade' <old-version>
#        * <old-preinst> 'abort-upgrade' <new-version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package.


case "$1" in
    install|upgrade)
        if [ -n "$2" ]; then
            # If an old version is specified, we are upgrading.
            # We can perform any necessary upgrade tasks here.
            systemctl stop millipede-caster.service || true
            systemctl disable millipede-caster.service || true
        else
            # No old version specified, this is a fresh install.
            echo "Installing millipede-caster for the first time."
            if $(id -u caster >/dev/null 2>&1); then \
                echo "User caster already created."
            else
                useradd -r -s /usr/sbin/nologin -m --user-group caster || true
            fi
            if [ -d /var/log/millipede ]; then \
                chown caster:caster /var/log/millipede || true
            else
                rm -rf /var/log/millipede || true
                mkdir -p -m 0755 /var/log/millipede || true
                chown caster:caster /var/log/millipede || true
            fi
        fi
    ;;

    abort-upgrade)
    ;;

    *)
        echo "preinst called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
